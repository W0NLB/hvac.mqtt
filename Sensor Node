/*
 * NodeMCU ESP8266 - SHT45 Sensor Node with SH1106 OLED Display
 * Purpose: Read temperature/humidity and publish to MQTT
 * Display: 1.3" SH1106 OLED shows IP, temp, and humidity
 * Devices: Thermostat and Monitor both subscribe to these readings
 */

#include <ESP8266WiFi.h>
#include <PubSubClient.h>
#include <Wire.h>
#include <Adafruit_SHT4x.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SH110X.h>

// Custom I2C pins for this board
#define OLED_SDA D6  // GPIO12
#define OLED_SCL D5  // GPIO14
#define SHT45_SDA D6 // GPIO4
#define SHT45_SCL D5 // GPIO5

// OLED Display settings (SH1106 1.3" 128x64)
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define OLED_ADDR 0x3C  // SH1106 typically uses 0x3C
#define TEMP_OFFSET_F   -2.8    // Sensor reads 3.3°F too high
#define HUM_OFFSET_PCT  -4.83   // Sensor reads 4.83% too high

Adafruit_SH1106G display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// Second I2C bus for SHT45
TwoWire I2C_SHT = TwoWire();

// WiFi credentials
const char* ssid = "SSID";
const char* password = "PASS";

// MQTT Broker settings
const char* mqtt_server = "BROKER IP";
const int mqtt_port = 1883;
const char* mqtt_user = "UN";
const char* mqtt_password = "PW";

// MQTT Topics - Sensor publishes to these
#define TOPIC_SENSOR_TEMP "hvac/sensor/temperature"
#define TOPIC_SENSOR_HUMIDITY "hvac/sensor/humidity"
#define TOPIC_SENSOR_STATUS "hvac/sensor/status"
#define TOPIC_SENSOR_LWT "hvac/sensor/lwt"

// SHT45 Sensor on default I2C pins
// NodeMCU: SDA = D2 (GPIO4), SCL = D1 (GPIO5)
Adafruit_SHT4x sht4 = Adafruit_SHT4x();

// MQTT Client
WiFiClient espClient;
PubSubClient mqttClient(espClient);

// Sensor data
float currentTemp = 0.0;
float currentHumidity = 0.0;

// Timers
unsigned long lastSensorRead = 0;
unsigned long lastMQTTPublish = 0;
unsigned long lastStatusPublish = 0;
unsigned long lastDisplayUpdate = 0;

const unsigned long sensorInterval = 2000;      // Read sensor every 2 seconds
const unsigned long publishInterval = 2000;     // Publish every 2 seconds
const unsigned long statusInterval = 10000;     // Status update every 10 seconds
const unsigned long displayInterval = 1000;     // Update display every second

// Function prototypes
void setupWiFi();
void setupMQTT();
void reconnectMQTT();
void readSensor();
void publishSensorData();
void publishStatus();
void updateDisplay();

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println("\n==========================================");
  Serial.println("NodeMCU ESP8266 - SHT45 Sensor Node");
  Serial.println("With 1.3\" SH1106 OLED Display");
  Serial.println("==========================================\n");

  // Initialize I2C for OLED (D6=SDA, D5=SCL)
  Serial.println("[1/5] Initializing I2C for OLED...");
  Wire.begin(OLED_SDA, OLED_SCL);
  Serial.println("       ✓ I2C ready (SDA=D6/GPIO12, SCL=D5/GPIO14)");

  // Initialize OLED Display (SH1106)
  Serial.println("[2/5] Initializing SH1106 OLED Display...");
  delay(250); // Wait for OLED to power up
  
  if (display.begin(OLED_ADDR, true)) {
    Serial.println("       ✓ SH1106 initialized at 0x3C");
    
    // Show startup screen
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SH110X_WHITE);
    display.setCursor(0, 0);
    display.println("HVAC Sensor Node");
    display.println("Initializing...");
    display.display();
  } else {
    Serial.println("       ✗ SH1106 not found!");
    Serial.println("          Check wiring:");
    Serial.println("          SDA -> D6 (GPIO12)");
    Serial.println("          SCL -> D5 (GPIO14)");
  }

  // Initialize I2C for SHT45 (D2=SDA, D1=SCL)
  Serial.println("[3/5] Initializing I2C for SHT45...");
  I2C_SHT.begin(SHT45_SDA, SHT45_SCL);
  Serial.println("       ✓ I2C ready (SDA=D2/GPIO4, SCL=D1/GPIO5)");

  // Initialize SHT45 Sensor
  Serial.println("[4/5] Initializing SHT45 Sensor...");
  if (sht4.begin(&I2C_SHT)) {
    sht4.setPrecision(SHT4X_HIGH_PRECISION);
    sht4.setHeater(SHT4X_NO_HEATER);
    Serial.println("       ✓ SHT45 initialized");
    Serial.print("       Serial Number: 0x");
    Serial.println(sht4.readSerial(), HEX);
    
    // Test read
    sensors_event_t humidity, temp;
    sht4.getEvent(&humidity, &temp);
    float tempF = temp.temperature * 9.0 / 5.0 + 32.0;
    Serial.print("       Test reading: ");
    Serial.print(tempF);
    Serial.print("°F, ");
    Serial.print(humidity.relative_humidity);
    Serial.println("%");
  } else {
    Serial.println("       ✗ SHT45 not found! Check wiring:");
    Serial.println("          SDA -> D2 (GPIO4)");
    Serial.println("          SCL -> D1 (GPIO5)");
    Serial.println("          VCC -> 3.3V");
    Serial.println("          GND -> GND");
    
    // Show error on OLED
    display.clearDisplay();
    display.setCursor(0, 0);
    display.println("ERROR:");
    display.println("SHT45 not found!");
    display.display();
  }

  // Connect WiFi
  Serial.println("[5/6] Connecting to WiFi...");
  display.clearDisplay();
  display.setCursor(0, 0);
  display.println("Connecting WiFi...");
  display.display();
  
  setupWiFi();

  // Setup MQTT
  Serial.println("[6/6] Setting up MQTT...");
  display.clearDisplay();
  display.setCursor(0, 0);
  display.println("Connecting MQTT...");
  display.display();
  
  setupMQTT();

  // Initial sensor read
  readSensor();

  Serial.println("\n==========================================");
  Serial.println("✓ SENSOR NODE READY - Publishing Data");
  Serial.println("==========================================\n");
  Serial.print("Current Temp: ");
  Serial.print(currentTemp);
  Serial.print("°F, Humidity: ");
  Serial.print(currentHumidity);
  Serial.println("%");
  
  // Show ready screen
  display.clearDisplay();
  display.setCursor(0, 0);
  display.println("READY!");
  display.display();
  delay(1000);
}

void loop() {
  // Check MQTT connection
  if (!mqttClient.connected()) {
    static unsigned long lastReconnectAttempt = 0;
    if (millis() - lastReconnectAttempt > 5000) {
      lastReconnectAttempt = millis();
      reconnectMQTT();
    }
  } else {
    mqttClient.loop();
  }

  // Read sensor
  if (millis() - lastSensorRead >= sensorInterval) {
    lastSensorRead = millis();
    readSensor();
  }

  // Publish sensor data
  if (millis() - lastMQTTPublish >= publishInterval) {
    lastMQTTPublish = millis();
    publishSensorData();
  }

  // Publish status
  if (millis() - lastStatusPublish >= statusInterval) {
    lastStatusPublish = millis();
    publishStatus();
  }

  // Update OLED display
  if (millis() - lastDisplayUpdate >= displayInterval) {
    lastDisplayUpdate = millis();
    updateDisplay();
  }

  delay(10);
}

void setupWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n       ✓ WiFi connected!");
    Serial.print("       IP: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\n       ✗ WiFi failed!");
  }
}

void setupMQTT() {
  mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setKeepAlive(15);
  mqttClient.setSocketTimeout(5);
  
  Serial.print("       Connecting to MQTT...");
  
  String clientId = "HVAC-Sensor-";
  clientId += String(ESP.getChipId(), HEX);
  
  if (mqttClient.connect(clientId.c_str(), mqtt_user, mqtt_password, TOPIC_SENSOR_LWT, 0, false, "offline")) {
    mqttClient.publish(TOPIC_SENSOR_LWT, "online", true);
    Serial.println("connected!");
    Serial.println("       ✓ MQTT ready");
  } else {
    Serial.print("failed! rc=");
    Serial.println(mqttClient.state());
    Serial.println("       ! MQTT will retry in loop");
  }
}

void reconnectMQTT() {
  if (mqttClient.connected()) return;
  
  String clientId = "HVAC-Sensor-";
  clientId += String(ESP.getChipId(), HEX);
  
  if (mqttClient.connect(clientId.c_str(), mqtt_user, mqtt_password, TOPIC_SENSOR_LWT, 0, false, "offline")) {
    mqttClient.publish(TOPIC_SENSOR_LWT, "online", true);
    Serial.println("[MQTT] Reconnected!");
  }
}

void readSensor() {
  sensors_event_t humidity, temp;
  sht4.getEvent(&humidity, &temp);
  
// Convert Celsius to Fahrenheit
float rawTempF = temp.temperature * 9.0 / 5.0 + 32.0;
float rawHumidity = humidity.relative_humidity;

// Apply compensation
float compensatedTempF = rawTempF + TEMP_OFFSET_F;
float compensatedHumidity = rawHumidity + HUM_OFFSET_PCT;
if (compensatedTempF > -40.0 && compensatedTempF < 257.0 &&
    compensatedHumidity >= 0.0 && compensatedHumidity <= 100.0) {

  currentTemp = compensatedTempF;
  currentHumidity = compensatedHumidity;
    // Debug output occasionally
    static int readCount = 0;
    if (++readCount >= 10) {
      Serial.print("[SHT45] Temp: ");
      Serial.print(currentTemp);
      Serial.print("°F, Humidity: ");
      Serial.print(currentHumidity);
      Serial.println("%");
      readCount = 0;
    }
  } else {
    Serial.println("[SHT45] Invalid reading detected!");
  }
}

void publishSensorData() {
  if (!mqttClient.connected()) return;
  
  // Publish temperature
  char tempStr[16];
  sprintf(tempStr, "%.1f", currentTemp);
  mqttClient.publish(TOPIC_SENSOR_TEMP, tempStr, true);  // Retained message
  
  // Publish humidity
  char humStr[16];
  sprintf(humStr, "%.1f", currentHumidity);
  mqttClient.publish(TOPIC_SENSOR_HUMIDITY, humStr, true);  // Retained message
  
  // Debug output occasionally
  static int pubCount = 0;
  if (++pubCount >= 5) {
    Serial.print("[MQTT] Published - Temp: ");
    Serial.print(tempStr);
    Serial.print("°F, Humidity: ");
    Serial.print(humStr);
    Serial.println("%");
    pubCount = 0;
  }
}

void publishStatus() {
  if (!mqttClient.connected()) return;
  
  // Publish status update with all info
  String status = "{";
  status += "\"temp\":" + String(currentTemp, 1) + ",";
  status += "\"humidity\":" + String(currentHumidity, 1) + ",";
  status += "\"ip\":\"" + WiFi.localIP().toString() + "\",";
  status += "\"rssi\":" + String(WiFi.RSSI()) + ",";
  status += "\"uptime\":" + String(millis() / 1000);
  status += "}";
  
  mqttClient.publish(TOPIC_SENSOR_STATUS, status.c_str());
  
  Serial.println("[STATUS] Published sensor status");
}

void updateDisplay() {
  display.clearDisplay();
  
  // Title
  display.setTextSize(1);
  display.setTextColor(SH110X_WHITE);
  display.setCursor(0, 0);
  display.println("HVAC Sensor Node");
  
  // Draw separator line
  display.drawLine(0, 10, SCREEN_WIDTH, 10, SH110X_WHITE);
  
  // IP Address
  display.setCursor(0, 14);
  display.print("IP: ");
  display.println(WiFi.localIP());
  
  // Temperature - Large text
  display.setTextSize(2);
  display.setCursor(0, 28);
  display.print(currentTemp, 1);
  display.setTextSize(1);
  display.print(" F");
  
  // Humidity
  display.setTextSize(2);
  display.setCursor(0, 48);
  display.print(currentHumidity, 0);
  display.setTextSize(1);
  display.print(" %");
  
  // MQTT Status indicator
  display.setCursor(100, 56);
  if (mqttClient.connected()) {
    display.print("MQTT");
  } else {
    display.print("----");
  }
  
  display.display();
}

/*
 * HARDWARE SETUP FOR NODEMCU ESP8266:
 * 
 * TWO SEPARATE I2C BUSES:
 * 
 * Bus 1 - OLED Display (Wire):
 * - SDA -> D6 (GPIO12)
 * - SCL -> D5 (GPIO14)
 * 
 * Bus 2 - SHT45 Sensor (I2C_SHT):
 * - SDA -> D2 (GPIO4)
 * - SCL -> D1 (GPIO5)
 * 
 * SH1106 OLED Display (1.3" 128x64):
 * - VCC  -> 3.3V or 5V (check your module)
 * - GND  -> GND
 * - SDA  -> D6 (GPIO12)
 * - SCL  -> D5 (GPIO14)
 * - Address: 0x3C (typical for SH1106)
 * 
 * SHT45 Sensor:
 * - VCC  -> 3.3V
 * - GND  -> GND
 * - SDA  -> D2 (GPIO4)
 * - SCL  -> D1 (GPIO5)
 * - Address: 0x44 (auto-detected)
 * 
 * POWER:
 * - USB power is fine for this application
 * - Can also use 5V power supply (VIN pin)
 * - Both devices can run from NodeMCU's regulator
 * 
 * WHY SEPARATE I2C BUSES:
 * - Your board uses D6/D5 for OLED
 * - Standard pins D2/D1 for SHT45
 * - ESP8266 supports software I2C on any GPIO
 * - This avoids any potential I2C conflicts
 * 
 * DISPLAY LAYOUT (1.3" SH1106):
 * ┌────────────────────────┐
 * │ HVAC Sensor Node       │
 * ├────────────────────────┤
 * │ IP: 192.168.0.xx       │
 * │                        │
 * │ 72.5 °F               │ ← Large temp
 * │                        │
 * │ 45 %                  │ ← Large humidity
 * │                  MQTT  │ ← Status
 * └────────────────────────┘
 * 
 * LIBRARY REQUIREMENTS:
 * - Adafruit GFX Library
 * - Adafruit SH110X (for SH1106 displays)
 * - Adafruit SHT4x Library
 * - PubSubClient
 * 
 * Install via Arduino Library Manager:
 * Tools > Manage Libraries > Search for each library
 */
