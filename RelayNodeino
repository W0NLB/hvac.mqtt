/*
 * ESP32 HVAC Relay Node with OLED Display - WATCHDOG SAFE VERSION
 * Board: ESP32-32E
 * Display: 1.3" OLED SH1106 @ 0x3D
 * Relays: 4-channel relay module


#include <WiFi.h>
#include <PubSubClient.h>
#include <ArduinoJson.h>
#include <U8g2lib.h>
#include <Wire.h>
#include "esp_task_wdt.h"

// WiFi credentials
const char* ssid = "SSID";
const char* password = "PASS";

// MQTT Broker settings
const char* mqtt_server = "BROKER IP";
const int mqtt_port = 1883;
const char* mqtt_user = "USERNAM";
const char* mqtt_password = "PASSWORD";
const char* mqtt_client_id = "RelayNode-Main";

// MQTT Topics
#define TOPIC_HEAT "hvac/relay/heat"
#define TOPIC_COOL "hvac/relay/cool"
#define TOPIC_FAN "hvac/relay/fan"
#define TOPIC_HUMID "hvac/relay/humidifier"
#define TOPIC_STATUS "hvac/relay/status"
#define TOPIC_RELAY_LWT "hvac/relay/lwt"

// Relay pins - VERIFY THESE MATCH YOUR WIRING!
#define RELAY_HEAT 5
#define RELAY_COOL 18
#define RELAY_FAN 15
#define RELAY_HUMID 19

// I2C pins for OLED
#define SDA_PIN 21
#define SCL_PIN 22

// OLED Display (SH1106 128x64 @ 0x3D)
U8G2_SH1106_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, /* reset=*/ U8X8_PIN_NONE, /* clock=*/ SCL_PIN, /* data=*/ SDA_PIN);

// MQTT Client
WiFiClient espClient;
PubSubClient mqttClient(espClient);

// Relay states
bool heatState = false;
bool coolState = false;
bool fanState = false;
bool humidifierState = false;

// Timers
unsigned long lastDisplay = 0;
unsigned long lastPublish = 0;
unsigned long lastLoopTime = 0;

const unsigned long displayInterval = 500;   // 500ms (smoother than 100ms)
const unsigned long publishInterval = 3000;  // 3 seconds

// Function prototypes
void setupWiFi();
void setupMQTT();
void mqttCallback(char* topic, byte* payload, unsigned int length);
void reconnectMQTT();
void setupRelays();
void setRelay(int pin, bool state);
void updateDisplay();
void publishStatus();

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println("\n==========================================");
  Serial.println("ESP32 HVAC Relay Node - Starting...");
  Serial.println("==========================================\n");

  // ===== Configure Watchdog First =====
  Serial.println("[WATCHDOG] Configuring watchdog timer...");
  
  // Deinitialize first in case it's already running
  esp_task_wdt_deinit();
  delay(100);
  
  // ESP32 Arduino Core 3.x+ uses new API
  esp_task_wdt_config_t wdt_config = {
    .timeout_ms = 30000,        // 30 seconds
    .idle_core_mask = 0,        // Don't watch idle tasks
    .trigger_panic = false      // Don't panic, just reset
  };
  esp_task_wdt_init(&wdt_config);
  esp_task_wdt_add(NULL);
  
  Serial.println("[WATCHDOG] Watchdog set to 30 seconds");

  // ===== Initialize I2C and OLED =====
  Serial.println("[1/5] Initializing OLED Display...");
  Wire.begin(SDA_PIN, SCL_PIN);
  
  if (!u8g2.begin()) {
    Serial.println("       ✗ OLED initialization failed!");
  } else {
    Serial.println("       ✓ OLED initialized (SH1106 @ 0x3D)");
  }
  
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tr);
  u8g2.drawStr(0, 12, "HVAC Relay Node");
  u8g2.drawStr(0, 28, "Initializing...");
  u8g2.sendBuffer();
  esp_task_wdt_reset();
  delay(1500);

  // ===== Setup Relays =====
  Serial.println("[2/5] Initializing Relays...");
  setupRelays();
  esp_task_wdt_reset();

  // ===== Connect to WiFi =====
  Serial.println("[3/5] Connecting to WiFi...");
  setupWiFi();
  esp_task_wdt_reset();

  // ===== Setup MQTT =====
  Serial.println("[4/5] Connecting to MQTT...");
  setupMQTT();
  esp_task_wdt_reset();

  // ===== Initial Status Publish =====
  Serial.println("[5/5] Publishing initial status...");
  publishStatus();

  Serial.println("\n==========================================");
  Serial.println("✓ RELAY NODE READY!");
  Serial.println("==========================================\n");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());
  Serial.println("Listening for MQTT commands...\n");
  
  esp_task_wdt_reset();
}

void loop() {
  // Monitor loop timing
  unsigned long loopStart = millis();
  unsigned long loopDuration = loopStart - lastLoopTime;
  
  if (loopDuration > 100) {
    Serial.print("[WARNING] Slow loop: ");
    Serial.print(loopDuration);
    Serial.println("ms");
  }
  lastLoopTime = loopStart;
  
  // Feed watchdog
  esp_task_wdt_reset();

  // Maintain MQTT connection (non-blocking)
  if (!mqttClient.connected()) {
    static unsigned long lastReconnectAttempt = 0;
    if (millis() - lastReconnectAttempt > 5000) {
      lastReconnectAttempt = millis();
      reconnectMQTT();
      esp_task_wdt_reset();
    }
  } else {
    mqttClient.loop();
  }

  // Update OLED display
  if (millis() - lastDisplay >= displayInterval) {
    lastDisplay = millis();
    updateDisplay();
    esp_task_wdt_reset();
  }

  // Publish status periodically
  if (millis() - lastPublish >= publishInterval) {
    lastPublish = millis();
    publishStatus();
    esp_task_wdt_reset();
  }
  
  // Small delay
  delay(2);
  esp_task_wdt_reset();
}

void setupWiFi() {
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tr);
  u8g2.drawStr(0, 12, "Connecting WiFi");
  u8g2.sendBuffer();
  
  WiFi.begin(ssid, password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(500);
    Serial.print(".");
    attempts++;
    
    // Feed watchdog every 5 attempts
    if (attempts % 5 == 0) {
      esp_task_wdt_reset();
    }
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n       ✓ WiFi connected!");
    Serial.print("       IP: ");
    Serial.println(WiFi.localIP());
    
    u8g2.clearBuffer();
    u8g2.drawStr(0, 12, "WiFi Connected!");
    u8g2.setFont(u8g2_font_5x7_tr);
    u8g2.drawStr(0, 28, WiFi.localIP().toString().c_str());
    u8g2.sendBuffer();
    delay(1500);
  } else {
    Serial.println("\n       ✗ WiFi connection failed!");
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_6x10_tr);
    u8g2.drawStr(0, 12, "WiFi Failed!");
    u8g2.drawStr(0, 28, "Check settings");
    u8g2.sendBuffer();
  }
}

void setupMQTT() {
  mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setCallback(mqttCallback);
  mqttClient.setKeepAlive(60);
  mqttClient.setSocketTimeout(5);
  
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tr);
  u8g2.drawStr(0, 12, "Connecting MQTT");
  u8g2.sendBuffer();
  
  // Single connection attempt with LWT
  if (mqttClient.connect(
      mqtt_client_id,
      mqtt_user,
      mqtt_password,
      TOPIC_RELAY_LWT,  // LWT topic
      0,                // QoS
      true,             // retained (changed to true so status persists)
      "offline"         // LWT payload
  )) {
    mqttClient.publish(TOPIC_RELAY_LWT, "online", true);
    Serial.println("       ✓ MQTT connected!");
    
    // Subscribe to all relay topics
    mqttClient.subscribe(TOPIC_HEAT);
    mqttClient.subscribe(TOPIC_COOL);
    mqttClient.subscribe(TOPIC_FAN);
    mqttClient.subscribe(TOPIC_HUMID);
    
    Serial.println("       ✓ Subscribed to all topics");
    
    u8g2.clearBuffer();
    u8g2.drawStr(0, 12, "MQTT Connected!");
    u8g2.sendBuffer();
    delay(1500);
  } else {
    Serial.print("       ✗ MQTT failed! rc=");
    Serial.println(mqttClient.state());
    Serial.println("       ! Will retry in loop");
    Serial.println("       ! Check: Mosquitto running? Auth correct?");
    
    u8g2.clearBuffer();
    u8g2.drawStr(0, 12, "MQTT Failed!");
    u8g2.setFont(u8g2_font_5x7_tr);
    String errStr = "rc=" + String(mqttClient.state());
    u8g2.drawStr(0, 28, errStr.c_str());
    u8g2.sendBuffer();
    delay(1500);
  }
}

void reconnectMQTT() {

  Serial.print("[MQTT] Reconnecting (");
  Serial.print(")... ");
  
  // Single quick attempt with LWT
  if (mqttClient.connect(
      mqtt_client_id,
      mqtt_user,
      mqtt_password,
      TOPIC_RELAY_LWT,  // LWT topic
      0,                // QoS
      true,             // retained
      "offline"         // LWT payload
  )) {
    mqttClient.publish(TOPIC_RELAY_LWT, "online", true);
    Serial.println("Success!");
    
    // Re-subscribe to all topics
    mqttClient.subscribe(TOPIC_HEAT);
    mqttClient.subscribe(TOPIC_COOL);
    mqttClient.subscribe(TOPIC_FAN);
    mqttClient.subscribe(TOPIC_HUMID);
    
    Serial.println("[MQTT] Resubscribed to all topics");
  } else {
    int state = mqttClient.state();
    Serial.print("Failed! rc=");
    Serial.print(state);
    
    // Decode error
    switch(state) {
      case -4: Serial.println(" (Connection timeout)"); break;
      case -3: Serial.println(" (Connection lost)"); break;
      case -2: Serial.println(" (Connect failed - Check auth/broker)"); break;
      case -1: Serial.println(" (Disconnected)"); break;
      case 1: Serial.println(" (Bad protocol)"); break;
      case 2: Serial.println(" (Client ID rejected)"); break;
      case 3: Serial.println(" (Server unavailable)"); break;
      case 4: Serial.println(" (Bad username/password)"); break;
      case 5: Serial.println(" (Not authorized)"); break;
      default: Serial.println(" (Unknown)"); break;
    }
  }
}

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  String message;
  for (unsigned int i = 0; i < length; i++) {
    message += (char)payload[i];
  }
  
  Serial.print("[MQTT] Message [");
  Serial.print(topic);
  Serial.print("]: ");
  Serial.println(message);

  // Parse command (ON/OFF)
  bool state = (message == "ON" || message == "1" || message == "true");

  // Control relays based on topic
  if (strcmp(topic, TOPIC_HEAT) == 0) {
    heatState = state;
    setRelay(RELAY_HEAT, heatState);
  } else if (strcmp(topic, TOPIC_COOL) == 0) {
    coolState = state;
    setRelay(RELAY_COOL, coolState);
  } else if (strcmp(topic, TOPIC_FAN) == 0) {
    fanState = state;
    setRelay(RELAY_FAN, fanState);
  } else if (strcmp(topic, TOPIC_HUMID) == 0) {
    humidifierState = state;
    setRelay(RELAY_HUMID, humidifierState);
  }
  
  // Immediately publish status after relay change
  publishStatus();
}

void setupRelays() {
  pinMode(RELAY_HEAT, OUTPUT);
  pinMode(RELAY_COOL, OUTPUT);
  pinMode(RELAY_FAN, OUTPUT);
  pinMode(RELAY_HUMID, OUTPUT);
  
  // Initialize all relays to OFF
  // Active HIGH relay modules: LOW = OFF, HIGH = ON
  digitalWrite(RELAY_HEAT, LOW);   // OFF
  digitalWrite(RELAY_COOL, LOW);   // OFF
  digitalWrite(RELAY_FAN, LOW);    // OFF
  digitalWrite(RELAY_HUMID, LOW);  // OFF
  
  Serial.println("       ✓ Relays initialized (Active HIGH)");
  Serial.println("       Pins: Heat=5, Cool=18, Fan=15, Humid=19");
}

void setRelay(int pin, bool state) {
  // Active HIGH relay module: HIGH = ON, LOW = OFF
  digitalWrite(pin, state ? HIGH : LOW);
  
  Serial.print("[RELAY] Pin ");
  Serial.print(pin);
  Serial.print(" → ");
  Serial.println(state ? "ON" : "OFF");
}

void updateDisplay() {
  u8g2.clearBuffer();
  
  // Title bar
  u8g2.setFont(u8g2_font_6x10_tr);
  u8g2.drawStr(0, 10, "HVAC Relay Node");
  u8g2.drawHLine(0, 12, 128);
  
  // IP Address (smaller font)
  u8g2.setFont(u8g2_font_5x7_tr);
  String ipStr = "IP:" + WiFi.localIP().toString();
  u8g2.drawStr(0, 22, ipStr.c_str());
  
  // Relay states in two columns
  u8g2.setFont(u8g2_font_6x10_tr);
  
  // Left column
  u8g2.drawStr(0, 35, "Heat:");
  u8g2.drawStr(40, 35, heatState ? "ON " : "OFF");
  
  u8g2.drawStr(0, 45, "Cool:");
  u8g2.drawStr(40, 45, coolState ? "ON " : "OFF");
  
  u8g2.drawStr(0, 55, "Fan:");
  u8g2.drawStr(40, 55, fanState ? "ON " : "OFF");
  
  // Right column
  u8g2.drawStr(70, 35, "Humid:");
  u8g2.drawStr(70, 45, humidifierState ? "ON " : "OFF");
  
  // MQTT status at bottom right
  u8g2.setFont(u8g2_font_5x7_tr);
  u8g2.drawStr(70, 55, mqttClient.connected() ? "MQTT:OK" : "MQTT:--");
  
  u8g2.sendBuffer();
}

void publishStatus() {
  if (!mqttClient.connected()) return;
  
  StaticJsonDocument<256> doc;
  doc["heat"] = heatState;
  doc["cool"] = coolState;
  doc["fan"] = fanState;
  doc["humidifier"] = humidifierState;
  doc["ip"] = WiFi.localIP().toString();
  doc["uptime"] = millis() / 1000;  // Uptime in seconds
  doc["rssi"] = WiFi.RSSI();  // WiFi signal strength in dBm
  
  char buffer[256];
  serializeJson(doc, buffer);
  
  bool published = mqttClient.publish(TOPIC_STATUS, buffer, false); //retain false
  
  if (published) {
    Serial.print("[MQTT] Published: ");
    Serial.println(buffer);
  } else {
    Serial.println("[MQTT] Publish failed!");
  }
}
